{
  "name": "@deniffer/posthog-cli",
  "version": "0.1.3",
  "description": "PostHog provider CLI for product-growth agents.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celados/gkit.git",
    "directory": "packages/posthog-cli"
  },
  "bin": {
    "posthog": "bin/posthog-cli.js",
    "posthog-cli": "bin/posthog-cli.js"
  },
  "files": [
    "index.ts",
    "constants.ts",
    "context.ts",
    "provider.ts",
    "services.ts",
    "schema.ts",
    "output.ts",
    "bin",
    "handlers",
    "lib",
    "!**/*.test.ts",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "posthog": "bun run ./index.ts",
    "cli": "bun run ./index.ts",
    "cli:schema": "bun run posthog --schema",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:once": "vitest run"
  },
  "dependencies": {
    "@posthog/agent-toolkit": "^0.2.4",
    "@standard-schema/spec": "^1.0.0",
    "@valibot/to-json-schema": "^1.6.0",
    "@deniffer/cli-kit": "github:Deniffer001/cli-kit#v0.1.2",
    "argc": "github:ethan-huo/argc#v7.5.0",
    "dotenv": "^17.2.2",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.13",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
