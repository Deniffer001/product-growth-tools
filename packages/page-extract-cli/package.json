{
  "name": "@deniffer/page-extract-cli",
  "version": "0.1.2",
  "description": "Page fetch and content extraction CLI for SEO and GEO workflows.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deniffer001/product-growth-tools.git",
    "directory": "packages/page-extract-cli"
  },
  "bin": {
    "page-extract": "bin/page-extract-cli.js",
    "page-extract-cli": "bin/page-extract-cli.js"
  },
  "files": [
    "index.ts",
    "context.ts",
    "provider.ts",
    "services.ts",
    "schema.ts",
    "output.ts",
    "bin",
    "handlers",
    "lib",
    "!**/*.test.ts",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "page-extract": "bun run ./index.ts",
    "cli": "bun run ./index.ts",
    "cli:schema": "bun run page-extract --schema",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:once": "vitest run"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@valibot/to-json-schema": "^1.6.0",
    "argc": "github:ethan-huo/argc",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.13",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
