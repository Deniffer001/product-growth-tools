{
  "name": "gkit",
  "version": "0.1.0",
  "private": true,
  "description": "Profile-bound, agent-first growth provider CLI.",
  "bin": {
    "gkit": "bin/gkit.js"
  },
  "files": [
    "bin",
    "docs",
    "generated",
    "policy",
    "scripts",
    "sources",
    "src",
    "evals",
    "!**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "cli": "bun run ./src/cli.ts",
    "check-types": "tsc --noEmit",
    "generate:dataforseo": "bun run ./scripts/generate-dataforseo.ts",
    "generate:dataforseo:check": "bun run ./scripts/generate-dataforseo.ts --check",
    "generate:bing": "bun run ./scripts/generate-bing.ts",
    "generate:bing:check": "bun run ./scripts/generate-bing.ts --check",
    "generate:google-ads": "bun run ./scripts/generate-google-ads.ts",
    "generate:google-ads:check": "bun run ./scripts/generate-google-ads.ts --check",
    "generate:gsc": "bun run ./scripts/generate-gsc.ts",
    "generate:gsc:check": "bun run ./scripts/generate-gsc.ts --check",
    "generate:posthog": "bun run ./scripts/generate-posthog.ts",
    "generate:posthog:check": "bun run ./scripts/generate-posthog.ts --check",
    "eval:slice5": "bun run ./src/eval.ts",
    "test": "vitest",
    "test:once": "vitest run"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@valibot/to-json-schema": "catalog:",
    "ajv": "catalog:",
    "argc": "catalog:",
    "google-auth-library": "catalog:",
    "valibot": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
