{
  "name": "gkit",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.10",
      "@types/node": "^25.6.0",
      "@valibot/to-json-schema": "^1.6.0",
      "ajv": "^8.20.0",
      "argc": "github:ethan-huo/argc#v7.5.0",
      "bun-types": "^1.3.13",
      "dataforseo-client": "^2.0.25",
      "dotenv": "^17.2.2",
      "typescript": "^5",
      "valibot": "^1.2.0",
      "vitest": "^4.0.18",
      "yaml": "^2.9.0"
    }
  },
  "type": "module",
  "scripts": {
    "check-types": "bun run --filter '*' check-types",
    "test": "bun run --filter '*' test:once",
    "sync:runtime": "bun run ./scripts/sync-product-growth-runtime.ts",
    "ai-optimization": "bun run --filter @deniffer/ai-optimization-cli cli",
    "backlink": "bun run --filter @deniffer/backlink-cli cli",
    "bing-webmaster": "bun run --filter @deniffer/bing-webmaster-cli cli",
    "gsc": "bun run --filter @deniffer/gsc-cli cli",
    "google-ads": "bun run --filter @deniffer/google-ads-cli cli",
    "page-extract": "bun run --filter @deniffer/page-extract-cli cli",
    "posthog": "bun run --filter @deniffer/posthog-cli cli",
    "serp-snapshot": "bun run --filter @deniffer/serp-snapshot-cli cli",
    "sitemap-watch": "bun run --filter @deniffer/sitemap-watch-cli cli"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.10"
}
