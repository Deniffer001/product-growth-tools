# Copy this file to a business profile:
# ~/.config/product-growth-tools/profiles/openclaw-web/.env
#
# Keep provider credential files under the profile credentials/ directory.
# Never commit profile .env files or credential files.

# Google Search Console
GSC_CREDENTIALS_FILE=./credentials/gsc.json
GSC_SITE_URL=sc-domain:openclawai.io

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_JSON_KEY_FILE_PATH=./credentials/google-ads.json
GOOGLE_ADS_CUSTOMER_ID=
# Optional. Set only when the account needs MCC/login-customer routing.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_LINKED_CUSTOMER_ID=
# Optional. Defaults to package-local .venv/bin/python3 when installed.
GOOGLE_ADS_PROVIDER_PYTHON_BIN=

# SERP snapshots
SERP_PROVIDER=dataforseo
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERP_DEFAULT_COUNTRY=US
SERP_DEFAULT_LANGUAGE=en
