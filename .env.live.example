# Copy to .env.live for local provider validation.
# Never commit .env.live or files under credentials/.

# Google Search Console
GSC_CREDENTIALS_FILE=./credentials/openclaw-web-gsc.json
GSC_SITE_URL=sc-domain:openclawai.io

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_JSON_KEY_FILE_PATH=./credentials/openclaw-web-google-ads.json
GOOGLE_ADS_CUSTOMER_ID=
# Optional. Set only when the account needs MCC/login-customer routing.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_LINKED_CUSTOMER_ID=
# Optional. Defaults to package-local .venv/bin/python3 when installed.
GOOGLE_ADS_PROVIDER_PYTHON_BIN=
